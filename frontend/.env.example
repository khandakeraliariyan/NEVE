# Neve API base URL (backend CLIENT_URL must match this app's origin, e.g. http://localhost:5173)
NEXT_PUBLIC_API_BASE_URL=

# Firebase web app config (Firebase console > Project settings > Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional: browser push notifications (Firebase Cloud Messaging).
# Sender ID: Project settings > Cloud Messaging > Sender ID.
# VAPID key: Project settings > Cloud Messaging > Web Push certificates > Key pair.
# The backend also needs PUSH_NOTIFICATIONS_ENABLED=true.
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
